# AWS
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# Besu (set after deploying besu-private-chain blueprint)
BESU_RPC_URL=http://vpce-xxx.vpce-svc-xxx.us-east-1.vpce.amazonaws.com:80

# Contract addresses (set after running deploy-contracts.sh)
SETTLEMENT_CONTRACT=0x...
TOKEN_ADDRESS=0x...
KEY_REGISTRY_ADDRESS=0x...

# Key addresses (derive KMS address with: npx ts-node scripts/get-kms-address.ts)
KMS_KEY_ID=alias/tokenized-cash/csi-signer
KMS_SIGNER_ADDRESS=0x...
RELAYER_ADDRESS=0x...
DEPLOYER_ADDRESS=0x...

# Wallet addresses (for the pilot)
CA_WALLET=0x...
MX_WALLET=0x...

# Chain
CHAIN_ID=70924
ALLOWED_CHAIN_ID=70924

# E2E test
API_URL=https://xxx.execute-api.us-east-1.amazonaws.com/v1
API_KEY=your-api-key
